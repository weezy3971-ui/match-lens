# Optional Foundry execution in the local Node service; set both or leave both empty.
# Keep credentials out of browser configuration.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_MODEL_DEPLOYMENT_NAME=

# The local service acquires an Entra token through the current Azure CLI sign-in.
# Authentication is attempted only for a Foundry request. Deployment identity is pending.
# Do not commit tokens or client secrets.
