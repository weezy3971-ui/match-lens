{
  "name": "matchlens-4d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node --experimental-strip-types infra/generate-validators.mjs",
    "pretest": "node --experimental-strip-types infra/generate-validators.mjs",
    "prebuild": "node --experimental-strip-types infra/generate-validators.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=./ && node infra/write-license-notices.mjs",
    "preview": "vite preview",
    "serve": "node --env-file-if-exists=.env.local --experimental-strip-types src/server/start.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "prebenchmark": "node --experimental-strip-types infra/generate-validators.mjs",
    "benchmark": "node --experimental-strip-types infra/benchmark.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "ajv": "^8.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
